# 私有 GHCR 固定版本；升级只替换为已经验证的固定 tag 或 digest。
RUSTDESK_IMAGE=ghcr.io/yaoguaijiao/rustdesk-server-s6-private:v2026.10.14.1

# 必填：客户端原先使用的公网 IP 或域名，不带协议、不带端口。
PUB_HOST=
# 必填：客户端使用的完整 API 地址，例如 http://your-host:21114。
# 有反向代理时填写原 http(s):// 地址，不必改变已有客户端配置。
PUBLIC_API_URL=

# 新安装可用相对目录；已有部署必须改为原数据目录的绝对路径。
# 123 服务器原路径：/opt/rustdesk/server_data 与 /opt/rustdesk/api_data。
SERVER_DATA_DIR=./server_data
API_DATA_DIR=./api_data

# 不在此文件保存 GitHub PAT、私钥、登录 token 或账号密码。
